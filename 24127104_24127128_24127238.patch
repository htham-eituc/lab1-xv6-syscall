+uint64 
+filecount(void) {
+    struct file *f;
+    uint64 count = 0;
+    
+    acquire(&ftable.lock);
+    
+    for (f = ftable.file; f < &ftable.file[NFILE]; f++) {
+        if (f->ref > 0) {
+            count++;
+        }
+    }
+    
+    release(&ftable.lock);
+    
+    return count;
+}
+
