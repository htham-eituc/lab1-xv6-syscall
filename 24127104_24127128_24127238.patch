+    printf("FAIL: nopenfiles did not increase\n");
+    exit(1);
+  }
+
+  close(fd);
+
+  sysinfo(&info);
+  printf("[testfiles] after close = %ld\n", info.nopenfiles);
+
+  if(info.nopenfiles != before){
+    printf("FAIL: nopenfiles did not decrease\n");
+    exit(1);
+  }
+}
 
