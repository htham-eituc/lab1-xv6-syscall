@@ -91,3 +91,19 @@ kalloc(void)
   return (void*)r;
 }
 
+uint64 
+freemem(void) {
+    struct run *r;
+    uint64 count = 0;
+    
+    acquire(&kmem.lock);
+    
+    for (r = kmem.freelist; r; r = r->next) {
+        count++;
+    }
+    
+    // Release the lock
+    release(&kmem.lock);
+    
+    return count * PGSIZE;
+}
